@page "/verification"

<PageTitle>DbcView interaction verification</PageTitle>

<main class="dbc-view-verification" aria-label="DbcView multi-host verification">
    <section data-testid="verification-host-a" aria-label="Workspace A">
        <DbcViewWorkspace WorkspaceName="dbc-view-a" />
    </section>
    <section data-testid="verification-host-b" aria-label="Workspace B">
        <DbcViewWorkspace WorkspaceName="dbc-view-b" />
    </section>
</main>
