@namespace DbcView.Web.Components
@using Atlas.Blazor.Content
@using DbcView.Domain
@using DbcView.Web.ViewModels
@implements IDisposable

<div class="dbc-editor" data-testid="dbc-editor" aria-label="DBC editor">
    @if (Model.DocumentId is null)
    {
        <div class="dbc-empty-state">
            <DbcIcon Name="file" Size="22" />
            <p class="dbc-empty-title">No document open</p>
            <p class="dbc-empty-hint">Choose a .dbc file in the explorer to inspect or edit it.</p>
        </div>
    }
    else
    {
        <div class="dbc-editor-toolbar">
            <span class="dbc-editor-file" title="@Model.DocumentId.Value.Key">
                <DbcIcon Name="file" Size="14" />
                <span class="dbc-editor-file-name">@Model.DocumentId.Value.Key</span>
            </span>
            <div class="dbc-segmented" role="group" aria-label="Editor view">
                <button type="button"
                        data-testid="dbc-mode-text"
                        aria-pressed="@(Model.Mode == DbcEditorModel.ViewMode.Text ? "true" : "false")"
                        @onclick="() => Model.SetMode(DbcEditorModel.ViewMode.Text)">Text</button>
                <button type="button"
                        data-testid="dbc-mode-table"
                        aria-pressed="@(Model.Mode == DbcEditorModel.ViewMode.Table ? "true" : "false")"
                        @onclick="() => Model.SetMode(DbcEditorModel.ViewMode.Table)">Table</button>
            </div>
        </div>

        @if (_titleFailure is not null)
        {
            <div class="dbc-alert error" role="alert" data-testid="dbc-title-error">
                <DbcIcon Name="error" Size="14" />
                <span>@_titleFailure</span>
            </div>
        }

        @if (_saveFailure is not null)
        {
            <div class="dbc-alert error" role="alert" data-testid="dbc-save-error">
                <DbcIcon Name="error" Size="14" />
                <span>@_saveFailure</span>
            </div>
        }
        else if (Model.SaveError is not null)
        {
            <div class="dbc-alert error" role="alert" data-testid="dbc-save-error">
                <DbcIcon Name="error" Size="14" />
                <span>@Model.SaveError</span>
            </div>
        }

        @if (Model.ParseResult is { HasErrors: true } parseResult)
        {
            <div class="dbc-alert error" role="alert" data-testid="dbc-parse-errors">
                <DbcIcon Name="error" Size="14" />
                <div class="dbc-alert-body">
                    <p class="dbc-alert-title">
                        @(Model.LastSaveResult is not null
                            ? $"Saved as an unvalidated draft ({parseResult.ErrorCount} DBC error(s)). Raw text was kept."
                            : $"This file contains {parseResult.ErrorCount} DBC error(s).")
                    </p>
                    <DbcDiagnosticList Diagnostics="parseResult.Diagnostics" />
                </div>
            </div>
        }
        else if (Model.ParseResult is { Diagnostics.Count: > 0 } withWarnings)
        {
            <div class="dbc-alert warning" role="status" data-testid="dbc-parse-warnings">
                <DbcIcon Name="warning" Size="14" />
                <div class="dbc-alert-body">
                    <p class="dbc-alert-title">
                        @(Model.LastSaveResult is not null
                            ? $"Saved with {withWarnings.Diagnostics.Count} DBC warning(s)."
                            : $"{withWarnings.Diagnostics.Count} DBC warning(s) found; the document is still usable.")
                    </p>
                    <DbcDiagnosticList Diagnostics="withWarnings.Diagnostics" />
                </div>
            </div>
        }
        else if (Model.LastSaveResult is not null)
        {
            <div class="dbc-alert success" role="status" data-testid="dbc-save-success">
                <DbcIcon Name="check" Size="14" />
                <span>Saved.</span>
            </div>
        }

        @if (Model.Mode == DbcEditorModel.ViewMode.Text)
        {
            <div class="dbc-editor-text">
                <textarea @bind="Model.EditedContent"
                          class="dbc-textarea"
                          spellcheck="false"
                          aria-label="DBC raw text"></textarea>
                <div class="dbc-editor-actions">
                    <button type="button" class="dbc-action primary"
                            data-testid="dbc-save"
                            @onclick="OnSave">Save</button>
                </div>
            </div>
        }
        else
        {
            <div class="dbc-editor-table">
                @if (Model.ParseResult is null)
                {
                    <div class="dbc-empty-state">
                        <DbcIcon Name="error" Size="22" />
                        <p class="dbc-empty-title">This file could not be parsed as DBC.</p>
                        <p class="dbc-empty-hint">Switch to Text view to inspect the raw content.</p>
                    </div>
                }
                else if (Model.ParseResult.HasErrors)
                {
                    <div class="dbc-empty-state">
                        <DbcIcon Name="warning" Size="22" />
                        <p class="dbc-empty-title">Table view is unavailable</p>
                        <p class="dbc-empty-hint">Fix the DBC errors above, then switch back to Table.</p>
                    </div>
                }
                else if (Model.Document!.Messages.Count == 0)
                {
                    <div class="dbc-empty-state">
                        <DbcIcon Name="table" Size="22" />
                        <p class="dbc-empty-title">No messages in this DBC file.</p>
                        <p class="dbc-empty-hint">The file is valid but declares no BO_ messages.</p>
                    </div>
                }
                else
                {
                    <table class="dbc-table">
                        <thead>
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Name</th>
                                <th scope="col">Len</th>
                                <th scope="col">Transmitter</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var message in Model.Document.Messages)
                            {
                                <tr class="dbc-message-row" data-message-id="@message.Id">
                                    <td>@message.Id</td>
                                    <td>
                                        <button type="button"
                                                class="dbc-link"
                                                data-testid="dbc-message"
                                                @onclick="() => HandleMessageSelected(message)">
                                            @message.Name
                                        </button>
                                    </td>
                                    <td>@message.Length</td>
                                    <td>@message.Transmitter</td>
                                </tr>
                                @foreach (var signal in message.Signals)
                                {
                                    <tr class="dbc-signal-row" data-signal-id="@signal.Name">
                                        <td></td>
                                        <td>
                                            <button type="button"
                                                    class="dbc-link dbc-signal-link"
                                                    data-testid="dbc-signal"
                                                    @onclick="() => HandleSignalSelected(signal)">
                                                <DbcIcon Name="signal" Size="12" />
                                                <span>@signal.Name</span>
                                            </button>
                                        </td>
                                        <td>@signal.Length</td>
                                        <td>@signal.Receiver</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }
</div>

@code {
    private string? _syncedTitle;
    private string? _saveFailure;
    private string? _titleFailure;

    /// <summary>
    /// The editor model. Single-panel tests pass it directly; the workspace
    /// path leaves it unset and the panel resolves the per-item model from the
    /// content state scope during initialization (FR-01).
    /// </summary>
    [Parameter]
    public DbcEditorModel Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public AtlasContentContext Content { get; set; } = null!;

    /// <summary>Gets or sets the application workspace used to resolve models from Context.</summary>
    [Parameter]
    public DbcFileWorkspace? Workspace { get; set; }

    /// <summary>Gets or sets the explorer model used to open the current selection into a fresh model.</summary>
    [Parameter]
    public DbcTreeModel? Tree { get; set; }

    [Parameter]
    public EventCallback<DbcMessage> OnMessageSelected { get; set; }

    [Parameter]
    public EventCallback<DbcSignal> OnSignalSelected { get; set; }

    protected override void OnInitialized()
    {
        if (Model is null)
        {
            if (Content is null)
            {
                throw new InvalidOperationException(
                    "DbcEditorPanel requires a Model or a Content context.");
            }

            Model = Content.GetOrCreateState<DbcEditorModel>(CreateModel);
        }

        Model.StateChanged += OnModelChanged;
    }

    private DbcEditorModel CreateModel()
    {
        if (Workspace is null)
        {
            throw new InvalidOperationException(
                "A DbcFileWorkspace is required to resolve an editor model from Content.");
        }

        var model = new DbcEditorModel(Workspace);

        // The factory runs once per ContentReference, when the item first
        // renders. At that moment the explorer selection is the file this tab
        // was opened for, so open it into the fresh model.
        if (Tree?.SelectedDocument is { } selected
            && DbcDocumentId.TryParseKey(Content.Reference.ResourceId, out var resourceId)
            && resourceId == selected)
        {
            var file = Workspace.Find(selected);
            if (file is not null)
            {
                model.Open(file);
            }
        }

        return model;
    }

    private void OnModelChanged()
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            var title = Model.DocumentId?.Key;
            var titleChanged = _syncedTitle != title;
            _syncedTitle = title;
            await InvokeAsync(StateHasChanged);
            if (titleChanged && title is not null && Content is not null)
            {
                await Content.Commands.UpdatePresentationAsync(title, iconKey: null);
            }
        }
        catch (Exception ex)
        {
            _titleFailure = $"Tab title update failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSave()
    {
        _saveFailure = null;
        try
        {
            Model.Save();
        }
        catch (Exception ex)
        {
            _saveFailure = $"Save failed: {ex.Message}";
        }
    }

    private Task HandleMessageSelected(DbcMessage message)
    {
        return OnMessageSelected.InvokeAsync(message);
    }

    private Task HandleSignalSelected(DbcSignal signal)
    {
        return OnSignalSelected.InvokeAsync(signal);
    }

    public void Dispose()
    {
        Model.StateChanged -= OnModelChanged;
    }
}
