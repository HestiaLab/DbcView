<header class="dbc-view-topbar" data-testid="dbc-view-top-toolbar">
    <div class="dbc-brand">
        <span class="dbc-brand-mark">
            <DbcIcon Name="database" Size="16" />
        </span>
        <span class="dbc-view-title">DbcView</span>
    </div>
    <div class="dbc-topbar-actions" role="group" aria-label="Workspace actions">
        @if (ShowPersistence)
        {
            <button type="button"
                    class="dbc-icon-button"
                    data-testid="dbc-persistence"
                    aria-pressed="@(PersistenceEnabled ? "true" : "false")"
                    aria-label="Session persistence"
                    title="@(PersistenceEnabled ? "Session persistence: On" : "Session persistence: Off")"
                    @onclick="OnPersistence">
                <DbcIcon Name="database" Size="16" />
            </button>
        }
        @if (CanSearch)
        {
            <button type="button"
                    class="dbc-icon-button"
                    data-testid="dbc-open-palette"
                    @onclick="OnSearch"
                    aria-label="Search messages and signals"
                    title="Search messages and signals (/)">
                <DbcIcon Name="search" Size="16" />
            </button>
        }
        <button type="button"
                class="dbc-icon-button"
                disabled="@(!CanUndo)"
                @onclick="OnUndo"
                aria-label="Undo layout change"
                title="Undo layout change">
            <DbcIcon Name="undo" Size="16" />
        </button>
        <button type="button"
                class="dbc-icon-button"
                disabled="@(!CanRedo)"
                @onclick="OnRedo"
                aria-label="Redo layout change"
                title="Redo layout change">
            <DbcIcon Name="redo" Size="16" />
        </button>
    </div>
</header>

@code {
    [Parameter]
    public bool CanUndo { get; set; }

    [Parameter]
    public bool CanRedo { get; set; }

    [Parameter]
    public bool CanSearch { get; set; }

    [Parameter]
    public bool ShowPersistence { get; set; }

    [Parameter]
    public bool PersistenceEnabled { get; set; }

    [Parameter]
    public EventCallback OnUndo { get; set; }

    [Parameter]
    public EventCallback OnRedo { get; set; }

    [Parameter]
    public EventCallback OnSearch { get; set; }

    [Parameter]
    public EventCallback OnPersistence { get; set; }
}
