@namespace DbcView.Web.Components
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog class="dbc-edit-dialog"
        data-testid="dbc-persistence-dialog"
        aria-label="Session persistence"
        @ref="_dialog"
        @onclose="OnDialogClosed">
    <div class="dbc-edit-body">
        <div class="dbc-edit-header">
            <h3>Session persistence</h3>
            <button type="button"
                    class="dbc-icon-button"
                    data-testid="dbc-persistence-close"
                    aria-label="Close session persistence"
                    @onclick="CloseAsync">
                <DbcIcon Name="close" Size="14" />
            </button>
        </div>
        <div class="dbc-edit-content">
            <p>
                Store this workspace in <strong>this browser only</strong>? Folders, file names,
                current document text, open tabs, the active tab and Table/Text view modes are
                kept in local IndexedDB. DBC content may be proprietary. Nothing is uploaded to
                a server, and unsaved Text drafts are not included.
            </p>
            @if (Enabled)
            {
                <p class="dbc-property-muted" data-testid="dbc-persistence-last-saved">
                    @LastSavedText
                </p>
            }
            @if (Error is not null)
            {
                <div class="dbc-alert error" role="alert" data-testid="dbc-persistence-error">
                    <DbcIcon Name="error" Size="14" />
                    <span>@Error</span>
                </div>
            }
        </div>
        <div class="dbc-edit-actions">
            @if (Enabled)
            {
                <button type="button"
                        class="dbc-action danger"
                        data-testid="dbc-persistence-forget"
                        @onclick="ForgetAsync">
                    Forget saved session
                </button>
            }
            else
            {
                <button type="button"
                        class="dbc-action primary"
                        data-testid="dbc-persistence-enable"
                        @ref="_primary"
                        @onclick="EnableAsync">
                    Enable local session
                </button>
            }
            <span class="dbc-edit-spacer"></span>
            <button type="button"
                    class="dbc-action"
                    data-testid="dbc-persistence-cancel"
                    @onclick="CloseAsync">
                Close
            </button>
        </div>
    </div>
</dialog>

@code {
    private ElementReference _dialog;
    private ElementReference _primary;
    private IJSObjectReference? _module;
    private bool _shown;
    private bool _closedNotified;

    [Parameter]
    public bool Enabled { get; set; }

    [Parameter]
    public DateTimeOffset? LastSavedAt { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public EventCallback OnEnable { get; set; }

    [Parameter]
    public EventCallback OnForget { get; set; }

    [Parameter]
    public EventCallback OnClosed { get; set; }

    private string LastSavedText => LastSavedAt is { } saved
        ? $"Last saved {saved.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)}."
        : "No session has been saved yet.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!OperatingSystem.IsBrowser() || _shown)
        {
            return;
        }

        _shown = true;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/dbc-palette.js");
            await _module.InvokeVoidAsync("showModal", _dialog, _primary);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task EnableAsync()
    {
        await OnEnable.InvokeAsync();
    }

    private async Task ForgetAsync()
    {
        await OnForget.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        await CloseDialogAsync();
        await NotifyClosedAsync();
    }

    private async Task OnDialogClosed()
    {
        await NotifyClosedAsync();
    }

    private async Task CloseDialogAsync()
    {
        if (!OperatingSystem.IsBrowser() || _module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("closeModal", _dialog);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task NotifyClosedAsync()
    {
        if (_closedNotified)
        {
            return;
        }

        _closedNotified = true;
        await OnClosed.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }
    }
}
