@implements IAsyncDisposable
@using Atlas.Blazor.Components
@using Atlas.Blazor.Content
@using Atlas.Core
@using Atlas.Core.Changes
@using Atlas.Core.Events
@using Atlas.Core.Items
@using Atlas.Core.Layout
@using Atlas.Core.Operations
@using DbcView.Application
@using DbcView.Domain
@using DbcView.Web.ViewModels
@using Microsoft.JSInterop
@inject IJSRuntime JS

<section class="dbc-view-shell" data-testid="dbc-view-shell" data-compact-active="@activePanel" data-document-open="@(currentDocument is not null ? "true" : "false")" aria-label="DbcView IDE workspace">
    @if (persistenceNotice is not null)
    {
        <div class="dbc-persistence-banner @(persistenceError is null ? "" : "is-error")"
             data-testid="dbc-persistence-notice"
             role="status">
            <span>@persistenceNotice</span>
            <button type="button"
                    class="dbc-icon-button"
                    aria-label="Dismiss session notice"
                    @onclick="DismissPersistenceNotice">
                <DbcIcon Name="close" Size="12" />
            </button>
        </div>
    }
    @if (workspace is not null)
    {
        <nav class="dbc-compact-nav" data-testid="dbc-compact-nav" aria-label="Workspace panels">
            <button type="button"
                    data-testid="dbc-compact-explorer"
                    aria-pressed="@(activePanel == "explorer" ? "true" : "false")"
                    @onclick='() => SetActivePanel("explorer")'>Explorer</button>
            <button type="button"
                    data-testid="dbc-compact-editor"
                    aria-pressed="@(activePanel == "editor" ? "true" : "false")"
                    @onclick='() => SetActivePanel("editor")'>Editor</button>
            <button type="button"
                    data-testid="dbc-compact-properties"
                    aria-pressed="@(activePanel == "properties" ? "true" : "false")"
                    @onclick='() => SetActivePanel("properties")'>Properties</button>
            <button type="button"
                    data-testid="dbc-compact-problems"
                    aria-pressed="@(activePanel == "problems" ? "true" : "false")"
                    @onclick='() => SetActivePanel("problems")'>Problems</button>
        </nav>
    }
    @if (workspace is null)
    {
        <div class="dbc-view-loading" role="status">Preparing DbcView workspace…</div>
    }
    else
    {
        <AtlasWorkspaceHost Workspace="@workspace"
                            WorkspaceOwnership="WorkspaceOwnership.External"
                            EnableInteractions="true">
            <TopToolbarContent>
                <DbcViewTopToolbar CanUndo="@(workspace?.CanUndo == true)"
                                     CanRedo="@(workspace?.CanRedo == true)"
                                     CanSearch="@(currentDocument is not null)"
                                     ShowPersistence="true"
                                     PersistenceEnabled="@persistenceEnabled"
                                     OnUndo="UndoAsync"
                                     OnRedo="RedoAsync"
                                     OnSearch="OpenPalette"
                                     OnPersistence="OpenPersistenceDialog" />
            </TopToolbarContent>
            <StatusBarContent>
                <DbcViewStatusBar OperationStatus="@operationStatus"
                                  Document="@currentDocument?.Key"
                                  Revision="@revision"
                                  Encoding="@currentEncoding"
                                  UndefinedByteCount="@currentUndefinedBytes"
                                  Persistence="@PersistenceStatus"
                                  ErrorCount="@errorCount"
                                  WarningCount="@warningCount"
                                  OnProblemsSelected="FocusProblemsAsync" />
            </StatusBarContent>
            <ContentRoutes>
                <AtlasContentRoute Kind="@DbcContentKinds.DbcTree">
                    <DbcTreePanel Model="dbcTree" />
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@DbcContentKinds.DbcEditor" Context="content">
                    <DbcEditorPanel Content="content"
                                    Workspace="dbcWorkspace"
                                    OnMessageSelected="ShowMessageProperties"
                                    OnSignalSelected="ShowSignalProperties"
                                    OnCheck="CheckFromEditorAsync" />
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@DbcContentKinds.DbcProperty">
                    <DbcPropertyPanel Model="dbcProperty"
                                      OnLocateSource="LocateSourceAsync"
                                      ApplyEdit="ApplyStructuredEdit" />
                </AtlasContentRoute>
                <AtlasContentRoute Kind="@DbcContentKinds.DbcProblems">
                    <DbcProblemsPanel @ref="problemsPanel"
                                      DocumentKey="@problemsDocumentKey"
                                      Diagnostics="problems"
                                      OnLocate="LocateProblemAsync" />
                </AtlasContentRoute>
            </ContentRoutes>

            <ErrorTemplate Context="content">
                @content.Code
            </ErrorTemplate>
        </AtlasWorkspaceHost>
    }
    @if (paletteOpen)
    {
        <DbcCommandPalette Model="paletteModel"
                           OnSelected="OnPaletteSelected"
                           OnCommandSelected="OnPaletteCommandSelected"
                           OnClosed="OnPaletteClosed" />
    }
    @if (persistenceDialogOpen)
    {
        <DbcPersistenceDialog Enabled="persistenceEnabled"
                              LastSavedAt="persistenceSavedAt"
                              Error="@persistenceError"
                              OnEnable="EnablePersistenceAsync"
                              OnForget="ForgetPersistenceAsync"
                              OnClosed="ClosePersistenceDialog" />
    }
</section>

@code {
    private readonly SemaphoreSlim openGate = new(1, 1);
    private readonly DbcCommandPaletteModel paletteModel = new();
    private DbcFileWorkspace dbcWorkspace = null!;
    private DbcTreeModel dbcTree = null!;
    private DbcPropertyModel dbcProperty = null!;
    private IAtlasWorkspace? workspace;
    private string operationStatus = "Ready";
    private string activePanel = "editor";
    private DbcDocumentId? currentDocument;
    private DockItemId? currentDocumentItemId;
    private long revision;
    private int errorCount;
    private int warningCount;
    private string? currentEncoding;
    private int currentUndefinedBytes;
    private bool editorPlaceholderConsumed;
    private int selectionVersion;
    private IJSObjectReference? paletteModule;
    private DotNetObjectReference<DbcViewWorkspace>? paletteReference;
    private bool paletteOpen;
    private bool paletteShortcutAttempted;
    private bool persistenceEnabled;
    private bool persistenceDialogOpen;
    private bool persistenceRestoreAttempted;
    private bool persistenceRestoring;
    private DateTimeOffset? persistenceSavedAt;
    private string? persistenceError;
    private string? persistenceNotice;
    private CancellationTokenSource? persistenceDebounce;
    private IReadOnlyList<DbcDiagnostic> problems = Array.Empty<DbcDiagnostic>();
    private string? problemsDocumentKey;
    private string? problemsCheckedContent;
    private CancellationTokenSource? problemsDebounce;
    private DbcProblemsPanel? problemsPanel;

    [Inject]
    private IAtlasWorkspaceFactory Factory { get; set; } = null!;

    [Inject]
    private IDbcWorkspaceComposition CompositionFactory { get; set; } = null!;

    [Inject]
    private DbcEditorNavigation Navigation { get; set; } = null!;

    [Inject]
    private DbcEditorSessionRegistry Sessions { get; set; } = null!;

    [Inject]
    private IWorkspacePersistence Persistence { get; set; } = null!;

    private string? PersistenceStatus
    {
        get
        {
            if (!persistenceEnabled)
            {
                return null;
            }

            if (persistenceError is not null)
            {
                return "Session storage error";
            }

            return persistenceSavedAt is { } saved
                ? $"Session saved {saved.ToLocalTime():HH:mm:ss}"
                : "Session on";
        }
    }

    [Parameter]
    public string WorkspaceName { get; set; } = "dbc-view";

    protected override void OnInitialized()
    {
        var result = Factory.Create(DbcViewWorkspaceDefinition.Create(WorkspaceName));
        if (!result.Succeeded || result.Value is null)
        {
            throw new InvalidOperationException(result.Error?.DiagnosticId ?? "DbcView initialization failed.");
        }

        workspace = result.Value;
        workspace.Changed += OnWorkspaceChanged;
        workspace.DomainEvents.ItemActivated += OnItemActivated;
        workspace.DomainEvents.ItemClosed += OnItemClosed;
        revision = workspace.Current.Revision;

        dbcWorkspace = CompositionFactory.CreateWorkspace();
        dbcWorkspace.Changed += OnDocumentStoreChanged;
        dbcTree = new DbcTreeModel(dbcWorkspace);
        dbcProperty = new DbcPropertyModel();
        dbcTree.DocumentSelectionChanged += OnDocumentSelectionChanged;
        Sessions.Changed += OnEditorSessionsChanged;
    }

    private void OnDocumentSelectionChanged()
    {
        _ = OpenSelectedDocumentAsync();
    }

    private async Task OpenSelectedDocumentAsync()
    {
        var version = Interlocked.Increment(ref selectionVersion);
        await openGate.WaitAsync();
        try
        {
            if (version != Volatile.Read(ref selectionVersion))
            {
                return;
            }

            if (workspace is null || dbcTree.SelectedDocument is not { } documentId)
            {
                return;
            }

            var file = dbcWorkspace.Find(documentId);
            if (file is null)
            {
                operationStatus = $"File '{documentId.Key}' no longer exists.";
                return;
            }

            // The initial pinned "DBC Editor" placeholder is consumed by the
            // first opened file. Closing it keeps every document tab keyed by
            // its own ContentReference, so the framework state scope can
            // resolve an independent editor model per file (FR-01).
            if (!editorPlaceholderConsumed)
            {
                var placeholderId = new DockItemId("dbc-editor");
                if (workspace.Current.Items.ContainsKey(placeholderId))
                {
                    var closeResult = await workspace.ExecuteAsync(new CloseItemOperation(placeholderId));
                    if (!closeResult.Succeeded)
                    {
                        operationStatus =
                            $"Could not close the editor placeholder ({FormatError(closeResult.Error)}).";
                        return;
                    }
                }

                editorPlaceholderConsumed = true;
            }

            // A fresh DockItemId per attempt lets ActivateExisting find an
            // already open tab by its full ContentReference (folder/file)
            // instead of failing on a duplicate id.
            var item = new DockItem(
                new DockItemId($"dbc-editor-{Guid.NewGuid():N}"),
                DockItemKind.Document,
                new ContentReference(DbcContentKinds.DbcEditor, documentId.Key),
                DockItemCapabilityPresets.Document,
                documentId.Key);
            var openResult = await workspace.ExecuteAsync(new OpenItemOperation(
                item,
                new LayoutNodeId("editor"),
                ContentDeduplicationMode.ActivateExisting));

            if (version != Volatile.Read(ref selectionVersion))
            {
                return;
            }

            if (!openResult.Succeeded)
            {
                operationStatus = $"Could not open '{documentId.Key}' ({FormatError(openResult.Error)}).";
                return;
            }

            dbcProperty.ShowFile(file);
            currentDocument = documentId;
            currentDocumentItemId = FindOpenItemId(documentId) ?? item.Id;
            currentEncoding = file.Encoding?.DisplayName;
            currentUndefinedBytes = file.Encoding?.UndefinedByteCount ?? 0;
            UpdateStatusDiagnostics();
            ShowProblemsForFile(documentId, file);
            operationStatus = $"Opened {documentId.Key}";
            activePanel = "editor";
        }
        catch (Exception ex)
        {
            operationStatus = $"Open failed: {ex.Message}";
        }
        finally
        {
            openGate.Release();
            await RefreshAsync();
        }
    }

    private static string FormatError(Atlas.Core.Results.WorkspaceError? error)
    {
        return error?.DiagnosticId ?? "unknown error";
    }

    private void ShowMessageProperties(DbcMessage message)
    {
        dbcProperty.ShowMessage(message);
        activePanel = "properties";
    }

    private void ShowSignalProperties(DbcSignal signal)
    {
        dbcProperty.ShowSignal(signal);
        activePanel = "properties";
    }

    private void SetActivePanel(string panel)
    {
        activePanel = panel;
    }

    private void OpenPalette()
    {
        if (paletteOpen || currentDocument is not { } documentId)
        {
            return;
        }

        if (dbcWorkspace.Find(documentId) is not { } file)
        {
            return;
        }

        paletteModel.SetDocument(file.ParseResult.Document, file.ParseResult.Semantics);
        paletteOpen = true;
    }

    private void OnPaletteClosed()
    {
        paletteOpen = false;
    }

    private async Task OnPaletteSelected(DbcPaletteResult result)
    {
        paletteOpen = false;
        activePanel = "editor";

        if (result.Signal is not null)
        {
            dbcProperty.ShowSignal(result.Signal);
        }
        else
        {
            dbcProperty.ShowMessage(result.Message);
        }

        if (result.Comment is not null)
        {
            dbcProperty.HighlightComment(result.Comment);
        }

        if (currentDocument is { } documentId)
        {
            Navigation.Request(new DbcEditorNavigationRequest(
                documentId,
                result.Message.Id,
                result.Signal?.Name));
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LocateSourceAsync(int lineNumber)
    {
        if (currentDocument is not { } documentId)
        {
            return;
        }

        activePanel = "editor";
        Navigation.Request(DbcEditorNavigationRequest.ForSource(documentId, lineNumber));
        await InvokeAsync(StateHasChanged);
    }

    private DbcStructuredEditOutcome ApplyStructuredEdit(DbcStructuredEdit edit)
    {
        if (currentDocument is not { } documentId)
        {
            return DbcStructuredEditOutcome.Fail("No document is open.");
        }

        if (Sessions.Find(documentId) is { IsTextDirty: true })
        {
            return DbcStructuredEditOutcome.Fail(
                "Save the text buffer before editing semantics.");
        }

        var outcome = dbcWorkspace.ApplyStructuredEdit(documentId, edit);
        if (!outcome.Success)
        {
            return outcome;
        }

        if (dbcWorkspace.Find(documentId) is { } file)
        {
            dbcProperty.Refresh(file);
        }

        Navigation.Request(DbcEditorNavigationRequest.ForReload(documentId));
        operationStatus = outcome.Diff is { } diff
            ? $"Applied {diff.Change} statement at line {diff.LineNumber}"
            : "Applied semantic edit";
        _ = RefreshAsync();
        return outcome;
    }

    [JSInvokable]
    public void OpenPaletteFromShortcut()
    {
        _ = InvokeAsync(() =>
        {
            OpenPalette();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (OperatingSystem.IsBrowser() && !persistenceRestoreAttempted)
        {
            persistenceRestoreAttempted = true;
            await RestoreSessionAsync();
        }

        if (!OperatingSystem.IsBrowser() || paletteShortcutAttempted)
        {
            return;
        }

        paletteShortcutAttempted = true;
        try
        {
            paletteModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/dbc-palette.js");
            paletteReference = DotNetObjectReference.Create(this);
            await paletteModule.InvokeVoidAsync("installShortcut", paletteReference);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task RestoreSessionAsync()
    {
        DbcPersistenceLoadResult load;
        try
        {
            load = await Persistence.LoadAsync();
        }
        catch (Exception ex)
        {
            SetPersistenceWarning($"Session restore failed: {ex.Message}");
            await RefreshAsync();
            return;
        }

        if (!load.Found)
        {
            if (!load.IsCompatible && load.Warning is not null)
            {
                SetPersistenceWarning(load.Warning);
                await RefreshAsync();
            }

            return;
        }

        if (!load.IsCompatible || load.Snapshot is null)
        {
            var warning = load.Warning ?? "The saved session could not be restored.";
            persistenceEnabled = false;
            persistenceError = warning;
            persistenceNotice = warning;
            operationStatus = "Saved session discarded";
            var cleared = await Persistence.ClearAsync();
            if (!cleared.Success)
            {
                persistenceError = $"{warning} {cleared.Error}";
                persistenceNotice = persistenceError;
            }

            await RefreshAsync();
            return;
        }

        persistenceRestoring = true;
        try
        {
            var snapshot = load.Snapshot;
            var files = snapshot.Files
                .Select(file => (Id: new DbcDocumentId(file.Folder, file.FileName), File: file))
                .ToArray();

            foreach (var folder in snapshot.Folders)
            {
                if (!dbcWorkspace.Folders.Contains(folder, StringComparer.Ordinal))
                {
                    dbcWorkspace.CreateFolder(folder);
                }
            }

            foreach (var (id, file) in files)
            {
                if (!dbcWorkspace.Folders.Contains(id.Folder, StringComparer.Ordinal))
                {
                    dbcWorkspace.CreateFolder(id.Folder);
                }

                if (dbcWorkspace.Find(id) is not null)
                {
                    continue;
                }

                var encoding = string.IsNullOrWhiteSpace(file.EncodingName)
                    ? null
                    : new DbcFileEncoding(
                        file.EncodingName,
                        file.EncodingFallback,
                        file.UndefinedByteCount);
                dbcWorkspace.Upload(id, file.Content, encoding);
            }

            var modes = new Dictionary<DbcDocumentId, DbcEditorModel.ViewMode>();
            foreach (var (id, file) in files)
            {
                if (Enum.TryParse<DbcEditorModel.ViewMode>(
                        file.ViewMode,
                        ignoreCase: true,
                        out var mode))
                {
                    modes[id] = mode;
                }
            }

            Sessions.SetRestoredModes(modes);
            DbcDocumentId? lastOpened = null;
            foreach (var document in snapshot.OpenDocuments)
            {
                var id = new DbcDocumentId(document.Folder, document.FileName);
                if (dbcWorkspace.Find(id) is null)
                {
                    continue;
                }

                await OpenRestoredDocumentAsync(id, updateProperty: false);
                lastOpened = id;
            }

            if (snapshot.ActiveDocument is { } active)
            {
                var id = new DbcDocumentId(active.Folder, active.FileName);
                if (dbcWorkspace.Find(id) is not null)
                {
                    await OpenRestoredDocumentAsync(id, updateProperty: true);
                    lastOpened = id;
                }
            }

            if (lastOpened is { } last && dbcWorkspace.Find(last) is { } lastFile)
            {
                dbcProperty.ShowFile(lastFile);
            }

            persistenceEnabled = true;
            persistenceSavedAt = snapshot.SavedAt;
            persistenceError = null;
            persistenceNotice =
                $"Restored local session saved at {snapshot.SavedAt.ToLocalTime():g}.";
            operationStatus = "Restored local session";
        }
        catch (Exception ex)
        {
            persistenceEnabled = false;
            persistenceError = $"Session restore failed: {ex.Message}";
            persistenceNotice = persistenceError;
            operationStatus = "Session restore failed";
        }
        finally
        {
            persistenceRestoring = false;
            await RefreshAsync();
        }
    }

    private async Task OpenRestoredDocumentAsync(
        DbcDocumentId documentId,
        bool updateProperty)
    {
        if (workspace is null)
        {
            return;
        }

        await openGate.WaitAsync();
        try
        {
            var file = dbcWorkspace.Find(documentId);
            if (file is null)
            {
                return;
            }

            if (!editorPlaceholderConsumed)
            {
                var placeholderId = new DockItemId("dbc-editor");
                if (workspace.Current.Items.ContainsKey(placeholderId))
                {
                    var closeResult = await workspace.ExecuteAsync(
                        new CloseItemOperation(placeholderId));
                    if (!closeResult.Succeeded)
                    {
                        operationStatus = "Could not prepare the editor for session restore.";
                        return;
                    }
                }

                editorPlaceholderConsumed = true;
            }

            var item = new DockItem(
                new DockItemId($"dbc-editor-{Guid.NewGuid():N}"),
                DockItemKind.Document,
                new ContentReference(DbcContentKinds.DbcEditor, documentId.Key),
                DockItemCapabilityPresets.Document,
                documentId.Key);
            var openResult = await workspace.ExecuteAsync(new OpenItemOperation(
                item,
                new LayoutNodeId("editor"),
                ContentDeduplicationMode.ActivateExisting));
            if (!openResult.Succeeded)
            {
                operationStatus = $"Could not restore '{documentId.Key}'.";
                return;
            }

            currentDocument = documentId;
            currentDocumentItemId = FindOpenItemId(documentId) ?? item.Id;
            currentEncoding = file.Encoding?.DisplayName;
            currentUndefinedBytes = file.Encoding?.UndefinedByteCount ?? 0;
            if (updateProperty)
            {
                dbcProperty.ShowFile(file);
            }

            UpdateStatusDiagnostics();
            ShowProblemsForFile(documentId, file);
            activePanel = "editor";
        }
        catch (Exception ex)
        {
            operationStatus = $"Session restore failed: {ex.Message}";
        }
        finally
        {
            openGate.Release();
        }
    }

    private void OpenPersistenceDialog()
    {
        persistenceDialogOpen = true;
    }

    private void ClosePersistenceDialog()
    {
        persistenceDialogOpen = false;
    }

    private void DismissPersistenceNotice()
    {
        persistenceNotice = null;
    }

    private async Task EnablePersistenceAsync()
    {
        persistenceEnabled = true;
        persistenceError = null;
        persistenceDialogOpen = false;
        await PersistNowAsync();
        if (persistenceError is null)
        {
            persistenceNotice = "Local session persistence enabled.";
            operationStatus = "Session persistence enabled";
        }

        await RefreshAsync();
    }

    private async Task ForgetPersistenceAsync()
    {
        var result = await Persistence.ClearAsync();
        if (result.Success)
        {
            persistenceEnabled = false;
            persistenceSavedAt = null;
            persistenceError = null;
            persistenceNotice = "Saved local session removed.";
            operationStatus = "Saved session forgotten";
        }
        else
        {
            persistenceError = result.Error;
            persistenceNotice = result.Error;
            operationStatus = "Could not clear the saved session";
        }

        persistenceDialogOpen = false;
        await RefreshAsync();
    }

    private void SchedulePersist()
    {
        if (!persistenceEnabled || persistenceRestoring || workspace is null)
        {
            return;
        }

        var cancellation = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref persistenceDebounce, cancellation);
        previous?.Cancel();
        _ = PersistAfterDelayAsync(cancellation.Token);
    }

    private async Task PersistAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(500, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(PersistNowAsync);
    }

    private async Task PersistNowAsync()
    {
        if (!persistenceEnabled || persistenceRestoring || workspace is null)
        {
            return;
        }

        var snapshot = BuildSnapshot();
        var hadError = persistenceError is not null;
        var result = await Persistence.SaveAsync(snapshot);
        if (result.Success)
        {
            persistenceSavedAt = snapshot.SavedAt;
            persistenceError = null;
            if (hadError)
            {
                persistenceNotice = null;
            }
        }
        else
        {
            persistenceError = result.Error;
            persistenceNotice = result.Error;
            operationStatus = "Local session could not be saved";
        }

        await RefreshAsync();
    }

    private DbcWorkspaceSnapshot BuildSnapshot()
    {
        var files = new List<DbcPersistedFile>();
        foreach (var folder in dbcWorkspace.Folders)
        {
            foreach (var file in dbcWorkspace.FilesIn(folder))
            {
                var viewMode = Sessions.Find(file.Id)?.Mode.ToString() ?? "Table";
                files.Add(new DbcPersistedFile(
                    folder,
                    file.Id.FileName,
                    file.Content,
                    file.Encoding?.Name,
                    file.Encoding?.IsFallback ?? false,
                    file.Encoding?.UndefinedByteCount ?? 0,
                    viewMode));
            }
        }

        var openDocuments = new List<DbcPersistedDocument>();
        if (workspace is not null)
        {
            foreach (var pair in workspace.Current.Items)
            {
                if (pair.Value.Kind != DockItemKind.Document
                    || !DbcDocumentId.TryParseKey(pair.Value.Content.ResourceId, out var id)
                    || dbcWorkspace.Find(id) is null)
                {
                    continue;
                }

                openDocuments.Add(new DbcPersistedDocument(id.Folder, id.FileName));
            }
        }

        var active = currentDocument is { } activeId
            ? new DbcPersistedDocument(activeId.Folder, activeId.FileName)
            : null;
        return new DbcWorkspaceSnapshot(
            DbcWorkspaceSnapshot.CurrentSchemaVersion,
            DateTimeOffset.UtcNow,
            dbcWorkspace.Folders.ToArray(),
            files,
            openDocuments,
            active);
    }

    private void SetPersistenceWarning(string warning)
    {
        persistenceEnabled = false;
        persistenceError = warning;
        persistenceNotice = warning;
        operationStatus = "Local session could not be restored";
    }

    private void ResetProblems()
    {
        problems = Array.Empty<DbcDiagnostic>();
        problemsDocumentKey = null;
        problemsCheckedContent = null;
        CancelScheduledCheck();
    }

    private void ShowProblemsForFile(DbcDocumentId documentId, DbcFileEntry file)
    {
        problems = file.ParseResult.Diagnostics;
        problemsDocumentKey = documentId.Key;
        problemsCheckedContent = file.Content;
        CancelScheduledCheck();
        UpdateProblemCheckState();
    }

    private void UpdateProblemCheckState()
    {
        if (currentDocument is not { } documentId
            || Sessions.Find(documentId) is not { } model)
        {
            return;
        }

        if (string.Equals(model.EditedContent, problemsCheckedContent, StringComparison.Ordinal))
        {
            return;
        }

        ScheduleCheck();
    }

    private void ScheduleCheck()
    {
        var cancellation = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref problemsDebounce, cancellation);
        previous?.Cancel();
        previous?.Dispose();
        _ = CheckAfterDelayAsync(cancellation.Token);
    }

    private async Task CheckAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(400, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(CheckCurrentDocumentAsync);
    }

    private void CancelScheduledCheck()
    {
        var pending = Interlocked.Exchange(ref problemsDebounce, null);
        pending?.Cancel();
        pending?.Dispose();
    }

    private async Task CheckFromEditorAsync()
    {
        await CheckCurrentDocumentAsync();
        await FocusProblemsAsync();
    }

    private async Task CheckCurrentDocumentAsync()
    {
        if (currentDocument is not { } documentId
            || dbcWorkspace.Find(documentId) is not { } file)
        {
            return;
        }

        CancelScheduledCheck();
        var model = Sessions.Find(documentId);
        var content = model?.EditedContent ?? file.Content;

        DbcParseResult result;
        try
        {
            result = model?.ValidateDownload() ?? dbcWorkspace.Parse(file.Content);
        }
        catch (Exception ex)
        {
            operationStatus = $"Check failed: {ex.Message}";
            await RefreshAsync();
            return;
        }

        problems = result.Diagnostics;
        problemsDocumentKey = documentId.Key;
        problemsCheckedContent = content;
        errorCount = result.ErrorCount;
        warningCount = result.Diagnostics.Count(
            diagnostic => diagnostic.Severity == DbcDiagnosticSeverity.Warning);
        operationStatus = result.Diagnostics.Count == 0
            ? $"Checked {documentId.Key}: no problems"
            : $"Checked {documentId.Key}: {result.ErrorCount} error(s), {warningCount} warning(s)";
        await RefreshAsync();
    }

    private async Task FocusProblemsAsync()
    {
        activePanel = "problems";
        await RefreshAsync();
        if (problemsPanel is not null)
        {
            await problemsPanel.FocusAsync();
        }
    }

    private async Task OnPaletteCommandSelected(DbcPaletteCommand command)
    {
        paletteOpen = false;
        if (string.Equals(
                command.Id,
                DbcCommandPaletteModel.CheckDocumentCommandId,
                StringComparison.Ordinal))
        {
            await CheckFromEditorAsync();
        }

        await RefreshAsync();
    }

    [JSInvokable]
    public void CheckDocumentFromShortcut()
    {
        _ = InvokeAsync(async () =>
        {
            await CheckFromEditorAsync();
            StateHasChanged();
        });
    }

    private async Task LocateProblemAsync(int lineNumber)
    {
        if (lineNumber <= 0 || currentDocument is null)
        {
            return;
        }

        await LocateSourceAsync(lineNumber);
    }

    private async Task UndoAsync()
    {
        if (workspace is null)
        {
            return;
        }

        var result = await workspace.UndoAsync();
        operationStatus = result.Succeeded ? "Move undone" : "Nothing to undo";
        await InvokeAsync(StateHasChanged);
    }

    private async Task RedoAsync()
    {
        if (workspace is null)
        {
            return;
        }

        var result = await workspace.RedoAsync();
        operationStatus = result.Succeeded ? "Move redone" : "Nothing to redo";
        await InvokeAsync(StateHasChanged);
    }

    private void OnWorkspaceChanged(object? sender, WorkspaceChangedEventArgs args)
    {
        revision = args.ChangeSet.AfterRevision;
        SchedulePersist();
        _ = RefreshAsync();
    }

    private void OnDocumentStoreChanged()
    {
        UpdateStatusDiagnostics();
        if (currentDocument is { } documentId)
        {
            if (dbcWorkspace.Find(documentId) is { } file)
            {
                dbcProperty.Refresh(file);
                ShowProblemsForFile(documentId, file);
            }
            else
            {
                ResetProblems();
            }
        }

        SchedulePersist();
        _ = RefreshAsync();
    }

    private void OnEditorSessionsChanged()
    {
        UpdateProblemCheckState();
        SchedulePersist();
    }

    private void OnItemActivated(object? sender, ItemActivatedEventArgs args)
    {
        if (workspace is null
            || !workspace.Current.Items.TryGetValue(args.ItemId, out var item)
            || item.Kind != DockItemKind.Document
            || !DbcDocumentId.TryParseKey(item.Content.ResourceId, out var documentId))
        {
            return;
        }

        currentDocument = documentId;
        currentDocumentItemId = args.ItemId;
        operationStatus = $"Opened {documentId.Key}";
        if (dbcWorkspace.Find(documentId) is { } file)
        {
            dbcProperty.ShowFile(file);
            currentEncoding = file.Encoding?.DisplayName;
            currentUndefinedBytes = file.Encoding?.UndefinedByteCount ?? 0;
            ShowProblemsForFile(documentId, file);
        }
        else
        {
            ResetProblems();
        }

        UpdateStatusDiagnostics();
        SchedulePersist();
        _ = RefreshAsync();
    }

    private void OnItemClosed(object? sender, ItemClosedEventArgs args)
    {
        if (currentDocumentItemId != args.ItemId)
        {
            return;
        }

        currentDocument = null;
        currentDocumentItemId = null;
        errorCount = 0;
        warningCount = 0;
        currentEncoding = null;
        currentUndefinedBytes = 0;
        paletteOpen = false;
        ResetProblems();
        operationStatus = "Ready";
        SchedulePersist();
        _ = RefreshAsync();
    }

    private DockItemId? FindOpenItemId(DbcDocumentId documentId)
    {
        if (workspace is null)
        {
            return null;
        }

        foreach (var pair in workspace.Current.Items)
        {
            if (pair.Value.Kind == DockItemKind.Document
                && DbcDocumentId.TryParseKey(pair.Value.Content.ResourceId, out var candidate)
                && candidate == documentId)
            {
                return pair.Key;
            }
        }

        return null;
    }

    private void UpdateStatusDiagnostics()
    {
        if (currentDocument is not { } documentId)
        {
            errorCount = 0;
            warningCount = 0;
            return;
        }

        var file = dbcWorkspace.Find(documentId);
        if (file is null)
        {
            currentDocument = null;
            currentDocumentItemId = null;
            errorCount = 0;
            warningCount = 0;
            return;
        }

        var errors = 0;
        var warnings = 0;
        foreach (var diagnostic in file.ParseResult.Diagnostics)
        {
            if (diagnostic.Severity == DbcDiagnosticSeverity.Error)
            {
                errors++;
            }
            else
            {
                warnings++;
            }
        }

        errorCount = errors;
        warningCount = warnings;
    }

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            operationStatus = $"Workspace refresh failed: {ex.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (workspace is null)
        {
            return;
        }

        workspace.Changed -= OnWorkspaceChanged;
        workspace.DomainEvents.ItemActivated -= OnItemActivated;
        workspace.DomainEvents.ItemClosed -= OnItemClosed;
        dbcWorkspace.Changed -= OnDocumentStoreChanged;
        dbcTree.DocumentSelectionChanged -= OnDocumentSelectionChanged;
        Sessions.Changed -= OnEditorSessionsChanged;
        persistenceDebounce?.Cancel();
        persistenceDebounce?.Dispose();
        persistenceDebounce = null;
        problemsDebounce?.Cancel();
        problemsDebounce?.Dispose();
        problemsDebounce = null;
        dbcTree.Dispose();
        dbcWorkspace.Dispose();
        await workspace.DisposeAsync();
        workspace = null;

        if (paletteModule is not null)
        {
            try
            {
                await paletteModule.InvokeVoidAsync("disposeShortcut");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }

            try
            {
                await paletteModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        paletteReference?.Dispose();
    }
}
