@namespace DbcView.Web.Components
@using DbcView.Web.ViewModels
@implements IDisposable

<div class="dbc-property" data-testid="dbc-property" aria-label="DBC properties">
    @if (Model.TargetType is null)
    {
        <p class="dbc-empty">Select a file, message, or signal to inspect.</p>
    }
    else
    {
        <div class="dbc-property-header">
            <span class="dbc-property-type">@Model.TargetType</span>
            <span class="dbc-property-name">@Model.TargetName</span>
        </div>
        <dl class="dbc-property-list">
            @if (Model.Id is not null)
            {
                <dt>Id</dt>
                <dd>@Model.Id</dd>
            }
            @if (Model.Name is not null)
            {
                <dt>Name</dt>
                <dd>@Model.Name</dd>
            }
            @if (Model.Length is not null)
            {
                <dt>Length</dt>
                <dd>@Model.Length</dd>
            }
            @if (Model.Transmitter is not null)
            {
                <dt>Transmitter</dt>
                <dd>@Model.Transmitter</dd>
            }
            @if (Model.StartBit is not null)
            {
                <dt>Start bit</dt>
                <dd>@Model.StartBit</dd>
            }
            @if (Model.Factor is not null)
            {
                <dt>Factor</dt>
                <dd>@Model.Factor</dd>
            }
            @if (Model.Offset is not null)
            {
                <dt>Offset</dt>
                <dd>@Model.Offset</dd>
            }
            @if (Model.Min is not null)
            {
                <dt>Min</dt>
                <dd>@Model.Min</dd>
            }
            @if (Model.Max is not null)
            {
                <dt>Max</dt>
                <dd>@Model.Max</dd>
            }
        </dl>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public DbcPropertyModel Model { get; set; } = null!;

    protected override void OnInitialized()
    {
        Model.StateChanged += OnModelChanged;
    }

    private void OnModelChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Model.StateChanged -= OnModelChanged;
    }
}
